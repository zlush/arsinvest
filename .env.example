# Dominio público del sitio. Se usa para canonical, og:url y el sitemap.
# Sin barra final. Si no se define, asume https://arsinvest.cl
VITE_SITIO=https://arsinvest.cl

# --- Recepción del formulario de contacto (api/contacto.js) ---
# Estas tres NO llevan prefijo VITE_ a propósito: cualquier variable VITE_*
# termina incrustada en el JavaScript que descarga el visitante.

# Casilla desde la que sale el correo. App Password de Google, no la
# contraseña de la cuenta.
SMTP_USER=
SMTP_PASS=

# Destinatario del aviso interno.
#
# PENDIENTE DE VALIDACIÓN: el sitio publicado indica
# patricia.corsi@arsinvest.cl y la propuesta menciona a "Patricia Grossi".
# Hay que confirmar el apellido y la casilla operativa antes de publicar, y
# probar la recepción con un envío real.
CONTACTO_DESTINO=
